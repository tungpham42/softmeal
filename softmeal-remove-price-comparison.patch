-async function requestGroq(
-  apiKey: string,
-  payload: Record<string, unknown>,
-  timeoutMs: number,
-): Promise<Record<string, unknown>> {
-  const response = await fetch("https://api.groq.com/openai/v1/chat/completions", {
-    method: "POST",
-    headers: {
-      Authorization: `Bearer ${apiKey}`,
-      "Content-Type": "application/json",
-    },
-    body: JSON.stringify(payload),
-    signal: AbortSignal.timeout(timeoutMs),
-  });
-
-  const responseText = await response.text().catch(() => "");
-  let data: unknown = null;
-  try {
-    data = JSON.parse(responseText);
-  } catch {
-    // Preserve a bounded plain-text provider response for diagnostics below.
-  }
-
-  if (!response.ok) {
-    let providerMessage = responseText.replace(/\s+/g, " ").slice(0, 400);
-    if (isRecord(data) && isRecord(data.error)) {
-      providerMessage = nullableText(data.error.message, 400) ?? providerMessage;
-    }
-    throw new GroqRequestError(
-      response.status,
-      providerMessage,
-      response.headers.get("x-groq-id") ?? response.headers.get("x-request-id"),
-    );
-  }
-
-  if (!isRecord(data)) {
-    throw new Error("Groq returned an invalid response body");
-  }
-  return data;
-}
