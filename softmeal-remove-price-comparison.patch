-function extractComparisonJson(content: string): Record<string, unknown> | null {
-  const text = content.replace(/```(?:json)?/gi, "").replace(/```/g, "").trim();
-
-  try {
-    const parsed: unknown = JSON.parse(text);
-    if (
-      isRecord(parsed) &&
-      typeof parsed.summary === "string" &&
-      Array.isArray(parsed.stores) &&
-      Array.isArray(parsed.ingredients)
-    ) {
-      return parsed;
-    }
-  } catch {
-    // The model may have included browser-search excerpts around its JSON.
-  }
-
-  for (let start = text.indexOf("{"); start >= 0; start = text.indexOf("{", start + 1)) {
-    let depth = 0;
-    let inString = false;
-    let escaped = false;
-
-    for (let end = start; end < text.length; end += 1) {
-      const char = text[end];
-
-      if (inString) {
-        if (escaped) {
-          escaped = false;
-        } else if (char === "\\") {
-          escaped = true;
-        } else if (char === '"') {
-          inString = false;
-        }
-        continue;
-      }
-
-      if (char === '"') {
-        inString = true;
-      } else if (char === "{") {
-        depth += 1;
-      } else if (char === "}") {
-        depth -= 1;
-        if (depth === 0) {
-          try {
-            const parsed: unknown = JSON.parse(text.slice(start, end + 1));
-            if (
-              isRecord(parsed) &&
-              typeof parsed.summary === "string" &&
-              Array.isArray(parsed.stores) &&
-              Array.isArray(parsed.ingredients)
-            ) {
-              return parsed;
-            }
-          } catch {
-            // Keep looking; a browser excerpt may itself contain JSON-like text.
-          }
-          break;
-        }
-      }
-    }
-  }
-
-  return null;
-}
