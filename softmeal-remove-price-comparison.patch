-function getAssistantContent(completion: Record<string, unknown>): {
-  content: string;
-  finishReason: string;
-} {
-  const choices = completion.choices;
-  if (!Array.isArray(choices) || !isRecord(choices[0]) || !isRecord(choices[0].message)) {
-    throw new Error("Groq did not return an assistant message");
-  }
-
-  const content = choices[0].message.content;
-  const finishReason = nullableText(choices[0].finish_reason, 80) ?? "unknown";
-  if (typeof content !== "string" || !content.trim()) {
-    throw new Error(`Groq returned empty content (finish_reason: ${finishReason})`);
-  }
-  return { content: content.trim(), finishReason };
-}
